# 로그 바이너리는 레포에 두지 않는다 — 원본은 FC 의 SD 카드에 있다
*.ulg
.venv/
__pycache__/

# 비행로그 바이너리 — 로컬에만 둔다 (레포는 문서만)
flights/**/*.BIN
flights/**/LASTLOG.TXT

# 에이전트 작업 지침 — 내부 운영 문서라 공개하지 않는다
CLAUDE.md

# 로그 뷰어 산출물 — extract.py 로 언제든 재생성
tools/logview/*.json

# 로그 뷰어 산출물 — 로그 원본에서 언제든 재생성
flights/**/*.json

# 웹 런타임 — 업로드·캐시·비밀은 커밋하지 않는다
web/.env
web/data/
