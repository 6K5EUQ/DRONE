#!/usr/bin/env bash
# DRONE01 라이브 — rim3 의 systemd 유닛(drone-live, drone-livepush)을 켜고 끈다.
#
#   ./drone-live            켠다 → http://localhost:4410
#   ./drone-live off        끈다
#   ./drone-live status     상태와 꽂힌 USB
#
# FC 는 USB id(3D_Robotics…v2)로 찾는다 — 다른 FC 는 안 잡는다. 안 꽂혀 있어도
# 켜진다 (로그 재생은 된다). 유닛 설치: web/README.md 「rim3」.
set -u
case "${1:-on}" in
  on)     systemctl --user start drone-live drone-livepush && echo "켰다 → http://localhost:4410" ;;
  off)    systemctl --user stop drone-live drone-livepush && echo "껐다" ;;
  status) systemctl --user --no-pager -n 3 status drone-live drone-livepush
          echo; ls /dev/serial/by-id/ 2>/dev/null || echo "USB 없음" ;;
  *)      echo "쓰기: $0 [on|off|status]" >&2; exit 1 ;;
esac
